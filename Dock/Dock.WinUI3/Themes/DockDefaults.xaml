<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Library-wide default resources for Dock.WinUI3.

         The library ships exactly two themes, both defined here:
           - "Default" = the black theme (primary; dark greys inspired by game
             editors, accent colors from the Windows accent ramp)
           - "Light"   = the light theme (neutral WinUI light greys)
         Runtime switching is native: set RequestedTheme on the window's root
         element (see DockThemeManager.SetTheme) and every {ThemeResource}
         reference re-resolves.

         Host apps can override ANY key — brushes, metrics, icon geometry — by
         defining the same key in Application.Resources (global) or inside their
         own ThemeDictionaries (per-theme). Control templates consume everything
         via {ThemeResource}, so overrides and theme switches are picked up. -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===== Black theme (primary) ===== -->
        <ResourceDictionary x:Key="Default">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="DockBackgroundBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DockChromeBackgroundBrush" Color="#141414" />
            <SolidColorBrush x:Key="DockPaneBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="DockFloatWindowBackgroundBrush" Color="#1A1A1A" />
            <!-- Tool caption -->
            <SolidColorBrush x:Key="DockCaptionBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="DockCaptionActiveBackgroundBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DockCaptionForegroundBrush" Color="#C5C5C5" />
            <SolidColorBrush x:Key="DockCaptionActiveForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockCaptionButtonHoverBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="DockCaptionButtonPressedBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="DockCaptionButtonForegroundBrush" Color="#C5C5C5" />
            <!-- Tabs -->
            <SolidColorBrush x:Key="DockTabItemBackgroundRestBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DockTabItemBackgroundHoverBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="DockTabItemBackgroundSelectedBrush" Color="#202020" />
            <SolidColorBrush x:Key="DockTabItemBackgroundSelectedUnfocusedBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="DockTabItemForegroundRestBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="DockTabItemForegroundHoverBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="DockTabItemForegroundSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockTabItemAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="DockTabCloseButtonHoverBrush" Color="#3A3A3A" />
            <!-- Borders -->
            <SolidColorBrush x:Key="DockBorderBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="DockPaneBorderBrush" Color="#2E2E2E" />
            <!-- Splitter (invisible at rest, game-editor style) -->
            <SolidColorBrush x:Key="DockSplitterBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="DockSplitterPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <!-- Drag/drop guides and preview -->
            <SolidColorBrush x:Key="DockDropPreviewFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
            <SolidColorBrush x:Key="DockDropPreviewStrokeBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="DockGuideBackgroundBrush" Color="#242424" />
            <SolidColorBrush x:Key="DockGuideBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="DockGuideGlyphBrush" Color="#C5C5C5" />
            <SolidColorBrush x:Key="DockGuideGlyphAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="DockGuideHoverBackgroundBrush" Color="#303030" />
            <!-- Auto-hide pin bar -->
            <SolidColorBrush x:Key="DockPinBarBackgroundBrush" Color="#141414" />
            <SolidColorBrush x:Key="DockPinItemForegroundBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="DockPinItemHoverBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="DockPinItemAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <!-- Acrylic material layer (Spec 05). Disabled by default via
                 AlwaysUseFallback: every brush renders its FallbackColor (the
                 matching solid surface color) until the host opts in through
                 DockThemeManager.SetAcrylicEnabled(true), which flips
                 AlwaysUseFallback on these instances at runtime. -->
            <Color x:Key="DockAcrylicTintColor">#1A1A1A</Color>
            <x:Double x:Key="DockAcrylicTintOpacity">0.75</x:Double>
            <x:Double x:Key="DockAcrylicLuminosityOpacity">0.85</x:Double>
            <AcrylicBrush x:Key="DockAcrylicFlyoutBrush"
                          TintColor="{StaticResource DockAcrylicTintColor}"
                          TintOpacity="{StaticResource DockAcrylicTintOpacity}"
                          TintLuminosityOpacity="{StaticResource DockAcrylicLuminosityOpacity}"
                          FallbackColor="#202020"
                          AlwaysUseFallback="True" />
            <!-- Legacy keys (pre-overhaul templates and existing consumers) -->
            <SolidColorBrush x:Key="DockChromeTabItemRestBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="DockChromeTabItemRestForeBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="DockChromeTabItemHoverBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="DockChromeTabItemPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DockChromeTabItemPressedForeBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockChromeTabItemSelectedUnfocusedBrush" Color="#1E1E1E" />
        </ResourceDictionary>

        <!-- ===== Light theme ===== -->
        <ResourceDictionary x:Key="Light">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="DockBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="DockChromeBackgroundBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="DockPaneBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockFloatWindowBackgroundBrush" Color="#F3F3F3" />
            <!-- Tool caption -->
            <SolidColorBrush x:Key="DockCaptionBackgroundBrush" Color="#E8E8E8" />
            <SolidColorBrush x:Key="DockCaptionActiveBackgroundBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DockCaptionForegroundBrush" Color="#444444" />
            <SolidColorBrush x:Key="DockCaptionActiveForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockCaptionButtonHoverBrush" Color="#22000000" />
            <SolidColorBrush x:Key="DockCaptionButtonPressedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="DockCaptionButtonForegroundBrush" Color="#444444" />
            <!-- Tabs -->
            <SolidColorBrush x:Key="DockTabItemBackgroundRestBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DockTabItemBackgroundHoverBrush" Color="#DEDEDE" />
            <SolidColorBrush x:Key="DockTabItemBackgroundSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockTabItemBackgroundSelectedUnfocusedBrush" Color="#EFEFEF" />
            <SolidColorBrush x:Key="DockTabItemForegroundRestBrush" Color="#616161" />
            <SolidColorBrush x:Key="DockTabItemForegroundHoverBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DockTabItemForegroundSelectedBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DockTabItemAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DockTabCloseButtonHoverBrush" Color="#CFCFCF" />
            <!-- Borders -->
            <SolidColorBrush x:Key="DockBorderBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="DockPaneBorderBrush" Color="#D6D6D6" />
            <!-- Splitter (invisible at rest, game-editor style) -->
            <SolidColorBrush x:Key="DockSplitterBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#C9C9C9" />
            <SolidColorBrush x:Key="DockSplitterPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <!-- Drag/drop guides and preview -->
            <SolidColorBrush x:Key="DockDropPreviewFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.30" />
            <SolidColorBrush x:Key="DockDropPreviewStrokeBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DockGuideBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockGuideBorderBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="DockGuideGlyphBrush" Color="#5F5F5F" />
            <SolidColorBrush x:Key="DockGuideGlyphAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DockGuideHoverBackgroundBrush" Color="#EDF3FA" />
            <!-- Auto-hide pin bar -->
            <SolidColorBrush x:Key="DockPinBarBackgroundBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="DockPinItemForegroundBrush" Color="#616161" />
            <SolidColorBrush x:Key="DockPinItemHoverBrush" Color="#DEDEDE" />
            <SolidColorBrush x:Key="DockPinItemAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <!-- Acrylic material layer (Spec 05) — see the Default dictionary note. -->
            <Color x:Key="DockAcrylicTintColor">#F3F3F3</Color>
            <x:Double x:Key="DockAcrylicTintOpacity">0.7</x:Double>
            <x:Double x:Key="DockAcrylicLuminosityOpacity">0.8</x:Double>
            <AcrylicBrush x:Key="DockAcrylicFlyoutBrush"
                          TintColor="{StaticResource DockAcrylicTintColor}"
                          TintOpacity="{StaticResource DockAcrylicTintOpacity}"
                          TintLuminosityOpacity="{StaticResource DockAcrylicLuminosityOpacity}"
                          FallbackColor="#FFFFFF"
                          AlwaysUseFallback="True" />
            <!-- Legacy keys (pre-overhaul templates and existing consumers) -->
            <SolidColorBrush x:Key="DockChromeTabItemRestBrush" Color="#E1E1E1" />
            <SolidColorBrush x:Key="DockChromeTabItemRestForeBrush" Color="#616161" />
            <SolidColorBrush x:Key="DockChromeTabItemHoverBrush" Color="#D0D0D0" />
            <SolidColorBrush x:Key="DockChromeTabItemPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DockChromeTabItemPressedForeBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DockChromeTabItemSelectedUnfocusedBrush" Color="#EFEFEF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ===== Metrics (theme-invariant) =====
         Defaults are tuned for a compact game-editor density. XAML consumers use
         {ThemeResource}; C#-side consumers go through DockMetrics (keep its
         fallback constants in sync with these values). -->
    <!-- Tool caption (chrome) -->
    <x:Double x:Key="DockToolChromeHeight">26</x:Double>
    <x:Double x:Key="DockCaptionFontSize">12</x:Double>
    <Thickness x:Key="DockCaptionPadding">8,0,4,0</Thickness>
    <x:Double x:Key="DockCaptionButtonSize">22</x:Double>
    <x:Double x:Key="DockCaptionGlyphSize">10</x:Double>
    <!-- Tabs -->
    <x:Double x:Key="DockToolTabItemHeight">24</x:Double>
    <x:Double x:Key="DockToolTabStripHeight">26</x:Double>
    <x:Double x:Key="DockDocumentTabItemHeight">24</x:Double>
    <x:Double x:Key="DockDocumentTabStripHeight">28</x:Double>
    <Thickness x:Key="DockTabItemPadding">8,0,4,0</Thickness>
    <x:Double x:Key="DockTabItemFontSize">12</x:Double>
    <CornerRadius x:Key="DockDocumentTabCornerRadius">4,4,0,0</CornerRadius>
    <CornerRadius x:Key="DockToolTabCornerRadius">0</CornerRadius>
    <x:Double x:Key="DockTabCloseButtonSize">16</x:Double>
    <x:Double x:Key="DockTabCloseGlyphSize">8</x:Double>
    <x:Double x:Key="DockActiveTabUnderlineThickness">2</x:Double>
    <!-- Splitter / borders -->
    <x:Double x:Key="DockSplitterThickness">4</x:Double>
    <Thickness x:Key="DockRootBorderThickness">1</Thickness>
    <!-- Float window -->
    <x:Double x:Key="DockFloatTitleBarHeight">32</x:Double>
    <!-- Auto-hide -->
    <x:Double x:Key="DockPinBarThickness">26</x:Double>
    <x:Double x:Key="DockPinnedFlyoutSize">300</x:Double>
    <!-- Drag/drop guides (consumed by the P4 rosette work) -->
    <x:Double x:Key="DockGuideSize">40</x:Double>
    <x:Double x:Key="DockRootGuideSize">36</x:Double>
    <x:Double x:Key="DockGuideEdgeInset">16</x:Double>
    <x:Double x:Key="DockGuideClusterMax">136</x:Double>

    <!-- ===== Icons (vector geometry, theme-invariant) =====
         Path data strings in a 16x16 design box. Geometry instances cannot be
         shared between elements in WinUI (a shared Style Data setter silently
         fails), so consume these through the DockIcon.Data attached property,
         which converts the string to a fresh Geometry per element:
             <Path local:DockIcon.Data="{ThemeResource DockIconCloseData}"
                   Width="16" Height="16" Fill="..."/>
         inside a Viewbox sized by the matching glyph-size metric. Hosts override
         an icon by redefining its string key. -->
    <x:String x:Key="DockIconCloseData">M3.57,2.43 L13.57,12.43 L12.43,13.57 L2.43,3.57 Z M12.43,2.43 L13.57,3.57 L3.57,13.57 L2.43,12.43 Z</x:String>
    <x:String x:Key="DockIconMenuData">M2.6,5.2 L8,10.6 L13.4,5.2 L12.3,4.1 L8,8.4 L3.7,4.1 Z</x:String>
    <x:String x:Key="DockIconPinData">M6,1.5 L10,1.5 L10,6 L12,8 L4,8 L6,6 Z M7.4,8.5 L8.6,8.5 L8,13.5 Z</x:String>
    <x:String x:Key="DockIconMaximizeData">M2,2 L14,2 L14,14 L2,14 Z M3.4,3.4 L3.4,12.6 L12.6,12.6 L12.6,3.4 Z</x:String>
    <x:String x:Key="DockIconAddData">M7.2,2 L8.8,2 L8.8,7.2 L14,7.2 L14,8.8 L8.8,8.8 L8.8,14 L7.2,14 L7.2,8.8 L2,8.8 L2,7.2 L7.2,7.2 Z</x:String>

    <!-- Dock guide glyphs (40x40 design box): mini window frame + title bar +
         filled half indicating the dock side + arrow. Consumed by
         DockTargetGuide via its GlyphData property. -->
    <!-- Two levels of docking, two visually separate glyph families. Sharing one
         family between them is what made them indistinguishable in practice.

         · PANE (cluster) — frame + the half that will be taken. No arrow: nothing
                leaves this pane.
         · ROOT (window border) — NO frame at all + a full-length edge bar + a large
                arrow: it leaves every container behind.

         Every path stays inside 8..32 so both families render at one size. -->

    <x:String x:Key="DockGuideGlyphLeftData">M8,10 L32,10 L32,30 L8,30 Z M9.5,11.5 L30.5,11.5 L30.5,28.5 L9.5,28.5 Z M9.5,11.5 L30.5,11.5 L30.5,13.5 L9.5,13.5 Z M9.5,13.5 L19.5,13.5 L19.5,28.5 L9.5,28.5 Z</x:String>
    <x:String x:Key="DockGuideGlyphRightData">M8,10 L32,10 L32,30 L8,30 Z M9.5,11.5 L30.5,11.5 L30.5,28.5 L9.5,28.5 Z M9.5,11.5 L30.5,11.5 L30.5,13.5 L9.5,13.5 Z M20.5,13.5 L30.5,13.5 L30.5,28.5 L20.5,28.5 Z</x:String>
    <x:String x:Key="DockGuideGlyphTopData">M8,10 L32,10 L32,30 L8,30 Z M9.5,11.5 L30.5,11.5 L30.5,28.5 L9.5,28.5 Z M9.5,11.5 L30.5,11.5 L30.5,13.5 L9.5,13.5 Z M9.5,13.5 L30.5,13.5 L30.5,20.5 L9.5,20.5 Z</x:String>
    <x:String x:Key="DockGuideGlyphBottomData">M8,10 L32,10 L32,30 L8,30 Z M9.5,11.5 L30.5,11.5 L30.5,28.5 L9.5,28.5 Z M9.5,11.5 L30.5,11.5 L30.5,13.5 L9.5,13.5 Z M9.5,21.5 L30.5,21.5 L30.5,28.5 L9.5,28.5 Z</x:String>


    <x:String x:Key="DockGuideGlyphRootLeftData">M8,10 L12,10 L12,30 L8,30 Z M27,13.5 L27,26.5 L16,20 Z</x:String>
    <x:String x:Key="DockGuideGlyphRootRightData">M28,10 L32,10 L32,30 L28,30 Z M13,13.5 L13,26.5 L24,20 Z</x:String>
    <x:String x:Key="DockGuideGlyphRootTopData">M8,10 L32,10 L32,14 L8,14 Z M13.5,27 L26.5,27 L20,16 Z</x:String>
    <x:String x:Key="DockGuideGlyphRootBottomData">M8,26 L32,26 L32,30 L8,30 Z M13.5,13 L26.5,13 L20,24 Z</x:String>
    <x:String x:Key="DockGuideGlyphCenterData">M8,10 L32,10 L32,30 L8,30 Z M9.5,11.5 L30.5,11.5 L30.5,28.5 L9.5,28.5 Z M9.5,11.5 L30.5,11.5 L30.5,13.5 L9.5,13.5 Z M11.5,15.5 L28.5,15.5 L28.5,26.5 L11.5,26.5 Z</x:String>

</ResourceDictionary>
