<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dock.WinUI3.Controls"
    xmlns:settings="using:Dock.Settings">

    <Style TargetType="local:DocumentControl">
        <Setter Property="settings:DockProperties.IsDropArea" Value="True"/>
        <Setter Property="settings:DockProperties.IsDockTarget" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DocumentControl">
                    <!-- The document pane card. The tab strip sits ON the card
                         (its own background is the card colour) and the content
                         below is one tier up, so the selected tab and the content
                         read as a single connected shape. -->
                    <Border x:Name="PART_PaneRoot"
                            Background="{ThemeResource DockPaneBackgroundBrush}"
                            BorderBrush="{ThemeResource DockPaneBorderBrush}"
                            BorderThickness="{ThemeResource DockPaneBorderThickness}"
                            CornerRadius="{ThemeResource DockPaneCornerRadius}">
                        <local:DockPanel x:Name="PART_DockPanel">
                            <local:DocumentTabStrip x:Name="PART_TabStrip"
                                                    local:DockPanel.Dock="Top"
                                                    MaxHeight="{ThemeResource DockDocumentTabStripHeight}">

                            </local:DocumentTabStrip>
                            <Border x:Name="PART_Border"
                                    local:DockPanel.Dock="Bottom"
                                    Background="{ThemeResource DockSurfaceRaisedBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{ThemeResource DockPaneBottomCornerRadius}"
                                    Padding="{ThemeResource DockPaneContentPadding}">
                                <local:DockableControl x:Name="PART_DockableControl"
                                                       TrackingMode="Visible">
                                    <local:DocumentContentControl x:Name="PART_DocumentContentControl"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                </local:DockableControl>
                            </Border>
                        </local:DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
