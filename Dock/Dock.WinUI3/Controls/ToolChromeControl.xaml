<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dock.WinUI3.Controls"
    xmlns:settings="using:Dock.Settings">

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{ThemeResource DockCaptionButtonSize}" />
        <Setter Property="Height" Value="{ThemeResource DockCaptionButtonSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_ButtonRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.BackgroundTransition>
                            <BrushTransition Duration="0:0:0.083"/>
                        </Border.BackgroundTransition>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ButtonRoot.(Background)" Value="{ThemeResource DockCaptionButtonHoverBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ButtonRoot.(Background)" Value="{ThemeResource DockCaptionButtonPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ButtonRoot.(Opacity)" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ToolChromeControl">
        <Setter Property="settings:DockProperties.IsDropArea" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToolChromeControl">
                    <!-- The pane card: the one opaque surface in a tool dock. The
                         layout chain above it is transparent so the window
                         backdrop shows through the gaps between cards. Border
                         clips its child to CornerRadius in WinUI, which is what
                         rounds the caption and the content below it.
                         PinnedDockControl clears this background by name when the
                         pane is an auto-hide flyout, so the acrylic it paints on
                         the outer DockableControl stays visible. -->
                    <Border x:Name="PART_PaneRoot"
                            Background="{ThemeResource DockPaneBackgroundBrush}"
                            BorderBrush="{ThemeResource DockPaneBorderBrush}"
                            BorderThickness="{ThemeResource DockPaneBorderThickness}"
                            CornerRadius="{ThemeResource DockPaneCornerRadius}">
                        <!-- WinUI requires VisualStateGroups on the template ROOT element;
                             attaching them to a child (PART_Border) makes GoToState a no-op. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="BorderStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Border.(Background)" Value="{ThemeResource DockCaptionBackgroundBrush}"/>
                                        <Setter Target="PART_Title.(Foreground)" Value="{ThemeResource DockCaptionForegroundBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Active">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Border.(Background)" Value="{ThemeResource DockCaptionActiveBackgroundBrush}"/>
                                        <Setter Target="PART_Title.(Foreground)" Value="{ThemeResource DockCaptionActiveForegroundBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid RowDefinitions="Auto,*">
                            <ContentPresenter Grid.Row="1" />
                            <Border x:Name="PART_Border"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    VerticalAlignment="Top"
                                    Grid.Row="0"
                                    Background="{ThemeResource DockCaptionBackgroundBrush}"
                                    Height="{ThemeResource DockToolChromeHeight}">
                                <Grid x:Name="PART_Grip"
                                      settings:DockProperties.IsDragArea="True">
                                    <local:DockPanel LastChildFill="True" Margin="{ThemeResource DockCaptionPadding}">
                                        <TextBlock x:Name="PART_Title"
                                                   local:DockPanel.Dock="Left"
                                                   FontSize="{ThemeResource DockCaptionFontSize}"
                                                   Foreground="{ThemeResource DockCaptionForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel local:DockPanel.Dock="Right"
                                                    Orientation="Horizontal">
                                            <Button x:Name="PART_MenuButton"
                                                    Style="{StaticResource ChromeButton}">
                                                <Viewbox Width="{ThemeResource DockCaptionGlyphSize}"
                                                         Height="{ThemeResource DockCaptionGlyphSize}">
                                                    <Path local:DockIcon.Data="{StaticResource DockIconMenuData}"
                                                          Width="16" Height="16"
                                                          Fill="{ThemeResource DockCaptionButtonForegroundBrush}"/>
                                                </Viewbox>
                                            </Button>
                                            <Button x:Name="PART_PinButton"
                                                    Style="{StaticResource ChromeButton}">
                                                <Viewbox Width="{ThemeResource DockCaptionGlyphSize}"
                                                         Height="{ThemeResource DockCaptionGlyphSize}">
                                                    <Path local:DockIcon.Data="{StaticResource DockIconPinData}"
                                                          Width="16" Height="16"
                                                          Fill="{ThemeResource DockCaptionButtonForegroundBrush}"/>
                                                </Viewbox>
                                            </Button>
                                            <Button x:Name="PART_MaximizeRestoreButton"
                                                    Style="{StaticResource ChromeButton}">
                                                <Viewbox Width="{ThemeResource DockCaptionGlyphSize}"
                                                         Height="{ThemeResource DockCaptionGlyphSize}">
                                                    <Path local:DockIcon.Data="{StaticResource DockIconMaximizeData}"
                                                          Width="16" Height="16"
                                                          Fill="{ThemeResource DockCaptionButtonForegroundBrush}"/>
                                                </Viewbox>
                                            </Button>
                                            <Button x:Name="PART_CloseButton"
                                                    Style="{StaticResource ChromeButton}">
                                                <Viewbox Width="{ThemeResource DockCaptionGlyphSize}"
                                                         Height="{ThemeResource DockCaptionGlyphSize}">
                                                    <Path local:DockIcon.Data="{StaticResource DockIconCloseData}"
                                                          Width="16" Height="16"
                                                          Fill="{ThemeResource DockCaptionButtonForegroundBrush}"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                        <Grid x:Name="PART_Grid" />
                                    </local:DockPanel>
                            </Grid>
                        </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
