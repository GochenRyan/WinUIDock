<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dock.WinUI3.Controls">

    <Style TargetType="local:HostWindowTitleBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HostWindowTitleBar">
                    <Border x:Name="PART_Border"
                            Margin="0,0,0,0"
                            VerticalAlignment="Stretch"
                            AutomationProperties.AutomationId="AppTitleBar"
                            Canvas.ZIndex="1"
                            IsHitTestVisible="True"
                            Background="{ThemeResource DockFloatWindowBackgroundBrush}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="PART_AppTitle"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{ThemeResource DockCaptionFontSize}"
                                Foreground="{ThemeResource DockCaptionForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
