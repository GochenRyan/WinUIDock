<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dock.WinUI3.Controls">

    <Style TargetType="local:DockTarget">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DockTarget">
                    <Grid x:Name="PART_WindowLayer">
                        <Grid x:Name="PART_RootSelectorsLayer"
                              IsHitTestVisible="True">

                            <Image x:Name="PART_RootTopSelector"
                                   Width="32"
                                   Height="32"
                                   Visibility="Collapsed"
                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableTop.png"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,12,0,0"/>

                            <Image x:Name="PART_RootBottomSelector"
                                   Width="32"
                                   Height="32"
                                   Visibility="Collapsed"
                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableBottom.png"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,12"/>

                            <Image x:Name="PART_RootLeftSelector"
                                   Width="32"
                                   Height="32"
                                   Visibility="Collapsed"
                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableLeft.png"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                            <Image x:Name="PART_RootRightSelector"
                                   Width="32"
                                   Height="32"
                                   Visibility="Collapsed"
                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableRight.png"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        </Grid>

                        <Canvas x:Name="PART_LocalCanvas"
                                IsHitTestVisible="True">

                            <Grid x:Name="PART_LocalHost"
                                  Canvas.Left="{TemplateBinding LocalX}"
                                  Canvas.Top="{TemplateBinding LocalY}"
                                  Width="{TemplateBinding LocalWidth}"
                                  Height="{TemplateBinding LocalHeight}">

                                <Grid x:Name="PART_IndicatorGrid"
                                      RowDefinitions="*,*"
                                      ColumnDefinitions="*,*">

                                    <Grid x:Name="PART_TopIndicator"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Background="Blue"
                                          Opacity="0"/>

                                    <Grid x:Name="PART_BottomIndicator"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Background="Blue"
                                          Opacity="0"/>

                                    <Grid x:Name="PART_LeftIndicator"
                                          Grid.Row="0"
                                          Grid.RowSpan="2"
                                          Grid.Column="0"
                                          Background="Blue"
                                          Opacity="0"/>

                                    <Grid x:Name="PART_RightIndicator"
                                          Grid.Row="0"
                                          Grid.RowSpan="2"
                                          Grid.Column="1"
                                          Background="Blue"
                                          Opacity="0"/>

                                    <Grid x:Name="PART_CenterIndicator"
                                          Grid.Row="0"
                                          Grid.RowSpan="2"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Background="Blue"
                                          Opacity="0"/>

                                    <Grid x:Name="PART_SelectorPanel"
                                          Grid.Row="0"
                                          Grid.RowSpan="2"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2">

                                        <Grid x:Name="PART_SelectorGrid"
                                              RowDefinitions="*,*,*"
                                              ColumnDefinitions="*,*,*"
                                              MaxWidth="125"
                                              MaxHeight="125"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">

                                            <Image x:Name="PART_TopSelector"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Width="40"
                                                   Height="40"
                                                   Visibility="Collapsed"
                                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableTop.png"/>

                                            <Image x:Name="PART_BottomSelector"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Width="40"
                                                   Height="40"
                                                   Visibility="Collapsed"
                                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableBottom.png"/>

                                            <Image x:Name="PART_LeftSelector"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Width="40"
                                                   Height="40"
                                                   Visibility="Collapsed"
                                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableLeft.png"/>

                                            <Image x:Name="PART_RightSelector"
                                                   Grid.Row="1"
                                                   Grid.Column="2"
                                                   Width="40"
                                                   Height="40"
                                                   Visibility="Collapsed"
                                                   Source="ms-appx:///Dock.WinUI3/Assets/DockAnchorableRight.png"/>

                                            <Image x:Name="PART_CenterSelector"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Width="40"
                                                   Height="40"
                                                   Visibility="Collapsed"
                                                   Source="ms-appx:///Dock.WinUI3/Assets/DockDocumentInside.png"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
