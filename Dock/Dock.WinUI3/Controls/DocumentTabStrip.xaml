<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dock.WinUI3.Controls">

    <Style TargetType="local:DocumentTabStrip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DocumentTabStrip">
                    <!-- Single row; overflow scrolls inside TabOverflowPanel.
                         A wrapping panel is a trap here: the second row gets
                         clipped by the strip's one-row height and those tabs
                         become unreachable. -->
                    <local:DockPanel LastChildFill="False"
                                     Background="{ThemeResource DockChromeBackgroundBrush}">
                        <!-- Docked right so it never scrolls out of reach. -->
                        <Button x:Name="PART_CreateButton"
                                local:DockPanel.Dock="Right"
                                VerticalAlignment="Center"
                                Margin="2,4,2,0"
                                Padding="0"
                                MinWidth="0"
                                MinHeight="0"
                                Width="{ThemeResource DockTabCloseButtonSize}"
                                Height="{ThemeResource DockTabCloseButtonSize}"
                                CornerRadius="2"
                                BorderThickness="0"
                                Background="Transparent"
                                Visibility="Collapsed">
                            <Viewbox Width="{ThemeResource DockTabCloseGlyphSize}"
                                     Height="{ThemeResource DockTabCloseGlyphSize}">
                                <Path local:DockIcon.Data="{StaticResource DockIconAddData}"
                                      Width="16" Height="16"
                                      Fill="{ThemeResource DockTabItemForegroundRestBrush}"/>
                            </Viewbox>
                        </Button>
                        <ItemsPresenter local:DockPanel.Dock="Left"/>
                    </local:DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:TabOverflowPanel Height="{ThemeResource DockDocumentTabStripHeight}"
                                            Background="{ThemeResource DockChromeBackgroundBrush}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:DocumentTabStripItem/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
