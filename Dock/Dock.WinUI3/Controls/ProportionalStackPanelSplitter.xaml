<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dock.WinUI3.Controls">

    <Style TargetType="local:ProportionalStackPanelSplitter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ProportionalStackPanelSplitter">
                    <Grid>
                        <!-- Invisible at rest (game-editor style); hover/pressed
                             brushes are applied in code (theme-aware lookup). -->
                        <Thumb x:Name="InternalThumb"
                               CanDrag="True"
                               Background="{ThemeResource DockSplitterBackgroundBrush}"
                               BorderThickness="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
