<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dock.WinUI3.Controls" xmlns:converters="using:Dock.WinUI3.Converters">

    <converters:IntLessThanConverter x:Key="LessThan2" TrueIfLessThan="2" />
    <converters:NormalConverter x:Key="DockConverter"/>

    <Style TargetType="local:HostWindowControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HostWindowControl">
                    <!-- Single-row float chrome: no dedicated title bar row.
                         The dock content fills the window and the top pane's
                         tab strip doubles as the title row (tabs left, blank
                         caption-drag fill, system buttons right) — see the
                         title-role arbitration in HostWindowControl. -->
                    <local:DockControl x:Name="PART_DockControl"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
