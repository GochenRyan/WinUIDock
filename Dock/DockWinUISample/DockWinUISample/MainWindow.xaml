<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    xmlns:winuiex="using:WinUIEx"
    x:Class="DockWinUISample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Dock.WinUI3.Controls"
    xmlns:modewinui3="using:Dock.Model.WinUI3"
    xmlns:winui3controls="using:Dock.Model.WinUI3.Controls"
    Title="WinUIDock Sample"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Background="{ThemeResource DockBackgroundBrush}">
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Layout..." Click="Open_Click"/>
                <MenuFlyoutItem Text="Save Layout..." Click="Save_Click"/>
            </MenuBarItem>

            <!-- Real panel visibility toggles: closing detaches the panel, ticking it
                 again asks the factory to put it back where it was. -->
            <MenuBarItem x:Name="ViewMenu" Title="View">
                <ToggleMenuFlyoutItem Tag="Outliner" Text="Outliner" IsChecked="True" Click="TogglePanel_Click"/>
                <ToggleMenuFlyoutItem Tag="AssetBrowser" Text="Asset Browser" IsChecked="True" Click="TogglePanel_Click"/>
                <MenuFlyoutSeparator/>
                <ToggleMenuFlyoutItem Tag="Properties" Text="Properties" IsChecked="True" Click="TogglePanel_Click"/>
                <ToggleMenuFlyoutItem Tag="Details" Text="Details" IsChecked="True" Click="TogglePanel_Click"/>
                <MenuFlyoutSeparator/>
                <ToggleMenuFlyoutItem Tag="Output" Text="Output" IsChecked="True" Click="TogglePanel_Click"/>
                <ToggleMenuFlyoutItem Tag="ErrorList" Text="Error List" IsChecked="True" Click="TogglePanel_Click"/>
            </MenuBarItem>

            <!-- Each item exercises a dock feature end to end; results go to Output. -->
            <MenuBarItem Title="Sample">
                <MenuFlyoutItem Text="Float Outliner" Click="FloatPanel_Click"/>
                <MenuFlyoutItem Text="Auto-hide (pin) Outliner" Click="PinPanel_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Close every tool in the left pane" Click="CloseLeftPane_Click"/>
                <MenuFlyoutItem Text="Restore last closed panel" Click="RestoreLast_Click"/>
                <MenuFlyoutItem Text="List parked (hidden) dockables" Click="ListHidden_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="New document" Click="NewDocument_Click"/>
                <MenuFlyoutItem Text="Check id uniqueness" Click="ValidateIds_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Reset to default layout" Click="ResetLayout_Click"/>
            </MenuBarItem>

            <!-- Each editor opens as a context of its own: separate window,
                 separate DockControl, separate Factory. Panels cannot be dragged
                 between a context and the main window. -->
            <MenuBarItem Title="Editors">
                <MenuFlyoutItem Text="Open Animation Editor" Click="OpenAnimationEditor_Click"/>
                <MenuFlyoutItem Text="Open Shader Graph" Click="OpenShaderGraph_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Reset editor layout templates" Click="ResetEditorTemplates_Click"/>
                <MenuFlyoutItem Text="Check editor contexts" Click="CheckEditorContexts_Click"/>
            </MenuBarItem>

            <MenuBarItem Title="Theme">
                <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="Dark" GroupName="ThemeGroup" IsChecked="True" Click="ThemeDark_Click"/>
                <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="Light" GroupName="ThemeGroup" Click="ThemeLight_Click"/>
            </MenuBarItem>

            <MenuBarItem Title="Material">
                <ToggleMenuFlyoutItem x:Name="AcrylicToggleItem" Text="Acrylic effects" Click="AcrylicToggle_Click"/>
                <MenuFlyoutSeparator/>
                <RadioMenuFlyoutItem x:Name="BackdropNoneItem" Text="No backdrop" GroupName="BackdropGroup" IsChecked="True" Click="BackdropNone_Click"/>
                <RadioMenuFlyoutItem x:Name="BackdropMicaItem" Text="Mica backdrop" GroupName="BackdropGroup" Click="BackdropMica_Click"/>
                <RadioMenuFlyoutItem x:Name="BackdropAcrylicItem" Text="Acrylic backdrop" GroupName="BackdropGroup" Click="BackdropAcrylic_Click"/>
            </MenuBarItem>
        </MenuBar>

        <!-- The Maya-Shelf role: a real toolbar, not a dock panel. A Toolbox that
             lives in a ToolDock inherits tabs, close and drag-away — none of which
             a shelf wants. Buttons reuse the Sample menu's handlers. -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsOpen="False"
                    HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton Icon="Add" Label="New document" Click="NewDocument_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="NewWindow" Label="Float Outliner" Click="FloatPanel_Click"/>
            <AppBarButton Icon="Pin" Label="Auto-hide Outliner" Click="PinPanel_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Refresh" Label="Reset layout" Click="ResetLayout_Click"/>
        </CommandBar>

        <controls:DockControl x:Name="Dock" Grid.Row="2" InitializeLayout="True" InitializeFactory="True">
            <controls:DockControl.Factory>
                <modewinui3:Factory/>
            </controls:DockControl.Factory>
            <winui3controls:RootDock x:Name="Root"
                                     Id="Root"
                                     IsCollapsable="False"
                                     DefaultDockable="{x:Bind Body, Mode=OneWay}">
                <winui3controls:RootDock.Windows>

                </winui3controls:RootDock.Windows>

                    <!-- Game-editor shape: HORIZONTAL with THREE columns (the toolbar
                         is the CommandBar above, outside the dock tree). The right
                         column is a direct child here, which is what lets it run the
                         full height: the bottom pane sits inside the centre column, so
                         it can no longer cut across the right one. -->
                    <winui3controls:ProportionalDock x:Name="Body" Id="Body" Orientation="Horizontal">

                        <winui3controls:ToolDock x:Name="LeftPane" Id="LeftPane" Proportion="0.2" Alignment="Left"
                                                 ActiveDockable="{x:Bind Outliner, Mode=OneWay}">
                            <winui3controls:Tool x:Name="Outliner" Id="Outliner" Title="Outliner">
                                <TextBlock Margin="8" Text="Scene outliner"/>
                            </winui3controls:Tool>
                            <winui3controls:Tool x:Name="AssetBrowser" Id="AssetBrowser" Title="Asset Browser">
                                <TextBlock Margin="8" Text="Asset browser"/>
                            </winui3controls:Tool>
                        </winui3controls:ToolDock>

                        <winui3controls:ProportionalDockSplitter x:Name="LeftSplitter" Id="LeftSplitter" />

                        <winui3controls:ProportionalDock x:Name="Center" Id="Center" Orientation="Vertical">

                            <winui3controls:DocumentDock x:Name="DocumentsPane" Id="DocumentsPane" CanCreateDocument="True"
                                                         ActiveDockable="{x:Bind Document1, Mode=OneWay}">
                                <winui3controls:Document x:Name="Document1" Id="Document1" Title="Program.cs">
                                    <!-- Mock code content: bright, varied lines so translucent
                                         materials (acrylic flyouts) visibly blur something. -->
                                    <StackPanel Padding="12,8" Spacing="2">
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#569CD6" Text="using System;"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#569CD6" Text="using Dock.WinUI3;"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Text=""/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#4EC9B0" Text="namespace DockWinUISample"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#D4D4D4" Text="{}{"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#DCDCAA" Text="    public static class Program"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#D4D4D4" Text="    {}{"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#C586C0" Text="        [STAThread]"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#DCDCAA" Text="        public static void Main(string[] args)"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#D4D4D4" Text="        {}{"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#CE9178" Text="            // Bootstraps the WinUI application."/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#FFFFFF" Text="            global::WinRT.ComWrappersSupport.InitializeComWrappers();"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#FFFFFF" Text="            Microsoft.UI.Xaml.Application.Start((p) =&gt; new App());"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#D4D4D4" Text="        }"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#D4D4D4" Text="    }"/>
                                        <TextBlock FontFamily="Consolas" FontSize="13" Foreground="#D4D4D4" Text="}"/>
                                    </StackPanel>
                                </winui3controls:Document>
                                <winui3controls:Document x:Name="Document2" Id="Document2" Title="App.xaml">
                                    <TextBlock Margin="8" Text="{x:Bind Document2.Title, Mode=OneWay}"/>
                                </winui3controls:Document>
                                <winui3controls:Document x:Name="Document3" Id="Document3" Title="Game.xaml">
                                    <TextBlock Margin="8" Text="{x:Bind Document3.Title, Mode=OneWay}"/>
                                </winui3controls:Document>
                            </winui3controls:DocumentDock>

                            <winui3controls:ProportionalDockSplitter x:Name="BottomSplitter" Id="BottomSplitter" />

                            <winui3controls:ToolDock x:Name="BottomPane" Id="BottomPane" Proportion="0.3" Alignment="Bottom"
                                                     ActiveDockable="{x:Bind Output, Mode=OneWay}">
                                <winui3controls:Tool x:Name="Output" Id="Output" Title="Output">
                                    <ScrollViewer>
                                        <TextBlock x:Name="OutputText" Margin="8" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" Text="Pick something from the Sample menu."/>
                                    </ScrollViewer>
                                </winui3controls:Tool>
                                <winui3controls:Tool x:Name="ErrorList" Id="ErrorList" Title="Error List">
                                    <TextBlock Margin="8" Text="No errors"/>
                                </winui3controls:Tool>
                            </winui3controls:ToolDock>

                        </winui3controls:ProportionalDock>

                        <winui3controls:ProportionalDockSplitter x:Name="RightSplitter" Id="RightSplitter" />

                        <winui3controls:ToolDock x:Name="RightPane" Id="RightPane" Proportion="0.22" Alignment="Right"
                                                 ActiveDockable="{x:Bind Properties, Mode=OneWay}">
                            <winui3controls:Tool x:Name="Properties" Id="Properties" Title="Properties">
                                <TextBlock Margin="8" Text="Properties — this column runs the full height."/>
                            </winui3controls:Tool>
                            <winui3controls:Tool x:Name="Details" Id="Details" Title="Details">
                                <TextBlock Margin="8" Text="Details"/>
                            </winui3controls:Tool>
                        </winui3controls:ToolDock>

                    </winui3controls:ProportionalDock>
            </winui3controls:RootDock>
        </controls:DockControl>
    </Grid>
</winuiex:WindowEx>
