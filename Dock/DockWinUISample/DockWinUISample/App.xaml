<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DockWinUISample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DockWinUISample"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
                <ResourceDictionary Source="ms-appx:///Dock.WinUI3/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <!-- No dock ThemeDictionaries: the library's built-in black/light
                 themes from Dock.WinUI3/Themes/DockDefaults.xaml apply. Override
                 individual Dock* keys here to customize. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
