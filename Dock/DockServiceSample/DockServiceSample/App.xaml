<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DockServiceSample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DockServiceSample"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
                <ResourceDictionary Source="ms-appx:///Dock.WinUI3/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <!-- Intentionally NO dock ThemeDictionaries: this sample exercises the
                 zero-registration path, where the library defaults from
                 Dock.WinUI3/Themes/DockDefaults.xaml must render everything. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
