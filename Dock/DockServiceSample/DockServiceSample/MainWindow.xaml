<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    xmlns:winuiex="using:WinUIEx"
    x:Class="DockServiceSample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DockServiceSample"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Dock.WinUI3.Controls" 
    xmlns:modewinui3="using:Dock.Model.WinUI3" 
    xmlns:winui3controls="using:Dock.Model.WinUI3.Controls"
    Title="WinUIDock Service Sample"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Background="{ThemeResource DockBackgroundBrush}">
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Layout..." Click="Open_Click"/>
                <MenuFlyoutItem Text="Save Layout..." Click="Save_Click"/>
            </MenuBarItem>

            <!-- These go through DockService, i.e. the service-layer API rather than
                 the factory directly — that is what this sample exists to show.
                 Check state mirrors the real layout, kept in sync by factory events. -->
            <MenuBarItem x:Name="ViewMenu" Title="View">
                <ToggleMenuFlyoutItem Tag="left_tool" Text="Left tool" IsChecked="True" Click="TogglePanel_Click"/>
                <ToggleMenuFlyoutItem Tag="right_tool" Text="Right tool" IsChecked="True" Click="TogglePanel_Click"/>
                <ToggleMenuFlyoutItem Tag="bottom_tool" Text="Bottom tool" IsChecked="True" Click="TogglePanel_Click"/>
                <ToggleMenuFlyoutItem Tag="window_tool" Text="Window tool" IsChecked="True" Click="TogglePanel_Click"/>
            </MenuBarItem>

            <MenuBarItem Title="Sample">
                <MenuFlyoutItem Text="Reset to default layout" Click="ResetDefault_Click"/>
                <MenuFlyoutItem Text="Save &amp; reload layout (round-trip test)" Click="RoundTrip_Click"/>
                <MenuFlyoutItem Text="List parked (hidden) dockables" Click="ListHidden_Click"/>
                <MenuFlyoutItem Text="Check id uniqueness" Click="ValidateIds_Click"/>
                <MenuFlyoutItem Text="Check window-edge docking" Click="CheckRootEdge_Click"/>
            </MenuBarItem>
        </MenuBar>

        <controls:DockControl x:Name="Dock" Grid.Row="1" InitializeLayout="True" InitializeFactory="True">
            <controls:DockControl.Factory>
                <modewinui3:Factory/>
            </controls:DockControl.Factory>
            <winui3controls:RootDock x:Name="Root"
                                     Id="Root"
                                     IsCollapsable="False"
                                     DefaultDockable="{x:Bind MainLayout, Mode=OneWay}"
                                     CanClose="False">
                <winui3controls:RootDock.Windows>

                </winui3controls:RootDock.Windows>

                <!-- Game-editor shape. Outer level is VERTICAL: a toolbar strip across
                     the top, everything else underneath. -->
                <winui3controls:ProportionalDock x:Name="MainLayout" Id="MainLayout" Orientation="Vertical">

                    <winui3controls:ToolDock x:Name="TopPane" Id="TopPane" Proportion="0" Alignment="Top" CanClose="False">
                    </winui3controls:ToolDock>

                    <winui3controls:ProportionalDockSplitter x:Name="TopSplitter" Id="TopSplitter" />

                    <!-- Inner level is HORIZONTAL with THREE columns. RightPane is a
                         direct child here, so it runs the full height; BottomPane lives
                         inside the centre column and no longer cuts across it. -->
                    <winui3controls:ProportionalDock x:Name="Body" Id="Body" Orientation="Horizontal">

                        <winui3controls:ToolDock x:Name="LeftPane" Id="LeftPane" Proportion="0.22" Alignment="Left" CanClose="False">
                        </winui3controls:ToolDock>

                        <winui3controls:ProportionalDockSplitter x:Name="LeftSplitter" Id="LeftSplitter" />

                        <winui3controls:ProportionalDock x:Name="Center" Id="Center" Orientation="Vertical">

                            <winui3controls:DocumentDock x:Name="DocumentPane" Id="DocumentPane" CanClose="False">
                            </winui3controls:DocumentDock>

                            <winui3controls:ProportionalDockSplitter x:Name="BottomSplitter" Id="BottomSplitter" />

                            <winui3controls:ToolDock x:Name="BottomPane" Id="BottomPane" Proportion="0.3" Alignment="Bottom" CanClose="False">
                            </winui3controls:ToolDock>

                        </winui3controls:ProportionalDock>

                        <winui3controls:ProportionalDockSplitter x:Name="RightSplitter" Id="RightSplitter" />

                        <winui3controls:ToolDock x:Name="RightPane" Id="RightPane" Proportion="0.22" Alignment="Right" CanClose="False">
                        </winui3controls:ToolDock>

                    </winui3controls:ProportionalDock>

                </winui3controls:ProportionalDock>
            </winui3controls:RootDock>
        </controls:DockControl>
    </Grid>
    
</winuiex:WindowEx>
