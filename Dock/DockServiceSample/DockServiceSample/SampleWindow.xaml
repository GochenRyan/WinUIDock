<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    xmlns:winuiex="using:WinUIEx"
    x:Class="DockServiceSample.SampleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Dock.WinUI3.Controls"
    xmlns:modewinui3="using:Dock.Model.WinUI3"
    xmlns:winui3controls="using:Dock.Model.WinUI3.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="Sample Window"
    mc:Ignorable="d">

    <!-- A real WINDOW, as opposed to the float panel the View menu shows: a
         separate top-level window carrying its own DockControl, Factory and
         RootDock. Its panels dock inside this window only — a float panel, by
         contrast, is torn out of the main window's tree and stays part of it.

         RegisterFactory="False" is what keeps this window out of the
         WinUIDockManager static facade: the service API this sample is built on
         must keep pointing at the MAIN dock. -->
    <Grid RowDefinitions="Auto,*" Background="{ThemeResource DockBackgroundBrush}">

        <!-- Same spare tall title bar as the main window: icon + title only. -->
        <toolkit:TitleBar Grid.Row="0"
                          Title="Sample Window"
                          DisplayMode="Tall"
                          AutoConfigureCustomTitleBar="True"
                          Window="{x:Bind}">
            <toolkit:TitleBar.Icon>
                <FontIcon Glyph="&#xE8A9;"/>
            </toolkit:TitleBar.Icon>
        </toolkit:TitleBar>

        <controls:DockControl x:Name="Dock" Grid.Row="1" InitializeLayout="True" InitializeFactory="True"
                              RegisterFactory="False">
            <controls:DockControl.Factory>
                <modewinui3:Factory/>
            </controls:DockControl.Factory>
            <winui3controls:RootDock x:Name="Root"
                                     Id="Root"
                                     IsCollapsable="False"
                                     CanClose="False"
                                     DefaultDockable="{x:Bind Body, Mode=OneWay}">
                <winui3controls:RootDock.Windows>

                </winui3controls:RootDock.Windows>

                <winui3controls:ProportionalDock x:Name="Body" Id="Body" Orientation="Horizontal">

                    <winui3controls:ToolDock x:Name="LeftPane" Id="LeftPane" Proportion="0.32" Alignment="Left"
                                             ActiveDockable="{x:Bind Briefing, Mode=OneWay}">
                        <winui3controls:Tool x:Name="Briefing" Id="Briefing" Title="Briefing">
                            <TextBlock Margin="8" TextWrapping="Wrap"
                                       Text="This window owns its dock context: drag this panel around and it docks inside this window only. The main window's guides never appear."/>
                        </winui3controls:Tool>
                    </winui3controls:ToolDock>

                    <winui3controls:ProportionalDockSplitter x:Name="Splitter" Id="Splitter"/>

                    <winui3controls:DocumentDock x:Name="DocumentPane" Id="DocumentPane" CanClose="False"
                                                 ActiveDockable="{x:Bind Notes, Mode=OneWay}">
                        <winui3controls:Document x:Name="Notes" Id="Notes" Title="Notes" CanClose="False">
                            <TextBlock Margin="8" TextWrapping="Wrap"
                                       Text="Window vs float panel: a float panel is torn out of the main window's layout and remains part of that context — same factory, same layout file. This window is a context of its own."/>
                        </winui3controls:Document>
                    </winui3controls:DocumentDock>

                </winui3controls:ProportionalDock>
            </winui3controls:RootDock>
        </controls:DockControl>
    </Grid>
</winuiex:WindowEx>
