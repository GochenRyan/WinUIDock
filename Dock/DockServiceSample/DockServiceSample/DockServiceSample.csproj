<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DockServiceSample</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged + self-contained, same shape as the LevelEditor.WinUI shell: the built exe
         runs directly (no MSIX deploy) and bundles the Windows App Runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Self-contained WinAppSDK content is contributed by every referenced Dock project,
         which collides on publish (NETSDK1152). Dedupe instead of erroring. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	<UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <ItemGroup>
    <!-- Labs preview; requires WindowsAppSDK 1.6+ (aligned solution-wide in 078). -->
    <PackageReference Include="CommunityToolkit.Labs.WinUI.Controls.TitleBar" Version="0.1.251217-build.2433" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Dock.Model.WinUI3\Dock.Model.WinUI3.csproj" />
    <ProjectReference Include="..\..\Dock.Serializer\Dock.Serializer.csproj" />
    <ProjectReference Include="..\..\Dock.WinUI3\Dock.WinUI3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <CustomAdditionalCompileInputs Remove="DocumentSampleControl1.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="DocumentSampleControl1.xaml" />
    <None Remove="ToolSampleControl1.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Remove="DocumentSampleControl1.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="ToolSampleControl1.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
